digraph ConnectFourZero {
  graph [
    rankdir=TB,
    bgcolor="#F7F8FA",
    pad="0.30",
    nodesep="0.52",
    ranksep="0.66 equally",
    splines=ortho,
    newrank=true,
    fontname="Helvetica Neue",
    fontsize=18,
    fontcolor="#101828",
    label="CONNECT FOUR ZERO  /  SELF-PLAY LEARNING LOOP",
    labelloc=t,
    labeljust=l
  ];

  node [
    shape=box,
    style="rounded,filled",
    fixedsize=true,
    width=2.72,
    height=1.02,
    fontname="Helvetica Neue",
    fontsize=11,
    fontcolor="#101828",
    color="#C7CED8",
    fillcolor="#FFFFFF",
    penwidth=1.35
  ];

  edge [
    fontname="Helvetica Neue",
    fontsize=9,
    fontcolor="#667085",
    color="#8793A3",
    penwidth=1.7,
    arrowsize=0.76
  ];

  champion [
    label="CHAMPION\ncurrent policy + value network",
    fillcolor="#E6EEFF",
    color="#5C87E4",
    penwidth=2.0,
    group="left"
  ];

  selfplay [
    label="SELF-PLAY + PUCT\n64 games · 256 searches per move",
    group="middle"
  ];

  replay [
    label="REPLAY MEMORY\n(state, search visits, final outcome)",
    fillcolor="#F0F4FA",
    color="#8DA5C7",
    group="right"
  ];

  arena [
    label="PAIRED ARENA\n>55% promotes · otherwise archive",
    fillcolor="#FFF3D6",
    color="#DCA63D",
    penwidth=1.9,
    group="left"
  ];

  candidate [
    label="CANDIDATE\nnew weights, not trusted yet",
    fillcolor="#FFF8E8",
    color="#DFB65E",
    group="middle"
  ];

  train [
    label="MPS TRAINING\npolicy + value loss · 449k params",
    group="right"
  ];

  { rank=same; champion; selfplay; replay; }
  { rank=same; arena; candidate; train; }

  champion -> selfplay;
  selfplay -> replay;
  replay -> train;
  arena -> candidate [style=invis, weight=100];
  candidate -> train [style=invis, weight=100];
  train -> candidate [constraint=false];
  candidate -> arena [constraint=false];
  champion -> arena [style=invis, weight=30];
  arena -> champion [
    xlabel="PROMOTE",
    color="#35A476",
    fontcolor="#26795A",
    penwidth=2.5
  ];

  observe [
    label="READ-ONLY OBSERVABILITY + AUDIT\nSQLite record  ·  Play / Lab / Evolution / Replay  ·  exact solver\nreads checkpoints and traces; never changes the training signal",
    width=8.85,
    height=1.08,
    fillcolor="#EEF1F5",
    color="#A8B1BE",
    style="rounded,filled,dashed",
    fontcolor="#4C5667"
  ];

  candidate -> observe [style=invis, weight=20];
  arena -> observe [style=dashed, color="#AAB3BF", penwidth=1.3, constraint=false];
}
